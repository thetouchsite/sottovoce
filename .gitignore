# Virtual environment: 3.5 GB, rebuilt by Install.bat
.venv/

# Uploaded recordings and their transcripts: they are data, and they are
# conversations with clients. They must never end up in a repository.
/transcripts/
/research/transcripts/

# Your glossary holds your clients' and products' names. The repo ships
# glossary.example.txt instead.
/glossary.txt

__pycache__/
*.pyc

# Screenshots from design checks: taken on real calls.
.taste-skill/

# Test runs
.pytest_cache/

# Voice models, downloaded on first use and checked by SHA-256
/models/
# Public meetings for research/voices.py, downloaded on first run
/research/ami/
# The PIN for --lan, and the secret that signs the devices let in
/.lan-pin
# The documentation site, built by mkdocs
/site/
